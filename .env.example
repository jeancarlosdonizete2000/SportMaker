# ============================================================================
# CONFIGURAÇÃO PRIVADA DO SERVIDOR BACKEND + MONGODB ATLAS
# (Variáveis sem prefixo VITE_ NUNCA são expostas ao navegador/frontend)
# ============================================================================

MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/sport_maker_db?retryWrites=true&w=majority
MONGODB_API_KEY=<sua_chave_api_aqui>
JWT_SECRET=<seu_segredo_jwt_aqui>
PORT=5000

# ============================================================================
# CONFIGURAÇÃO PÚBLICA DO FRONTEND (Apenas URL da API do Backend)
# ============================================================================
VITE_API_URL=http://localhost:5000/api

